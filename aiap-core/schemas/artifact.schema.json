{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aiap.dev/v0.3/schemas/artifact.schema.json",
  "title": "AIAP Artifact v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "media_type",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^aiap:artifact:[A-Za-z0-9._~-]{8,128}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "maxLength": 300
    },
    "uri": {
      "type": "string",
      "format": "uri-reference"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "portable": {
      "type": "boolean",
      "default": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$comment": "SPDX-License-Identifier: Apache-2.0; Copyright 2026 Wang Lu"
}
