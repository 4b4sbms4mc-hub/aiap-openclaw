{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aiap.dev/v0.3/schemas/extension.schema.json",
  "title": "AIAP Extension Manifest v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extension_id",
    "namespace",
    "name",
    "version",
    "capabilities"
  ],
  "properties": {
    "extension_id": {
      "type": "string",
      "pattern": "^aiap:extension:[A-Za-z0-9._~-]{8,128}$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "publisher": {
      "type": "object",
      "additionalProperties": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$comment": "SPDX-License-Identifier: Apache-2.0; Copyright 2026 Wang Lu"
}
