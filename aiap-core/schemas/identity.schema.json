{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aiap.dev/v0.3/schemas/identity.schema.json",
  "title": "AIAP Identity Record v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "avatar_id",
    "owner",
    "avatar_keys",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "avatar_id": {
      "type": "string",
      "pattern": "^aiap:avatar:[A-Za-z0-9._~-]{8,128}$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "identity_assurance",
        "verification_keys"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "pattern": "^aiap:owner:[A-Za-z0-9._~-]{8,128}$"
        },
        "identity_assurance": {
          "enum": [
            "anonymous",
            "verified",
            "high_assurance"
          ]
        },
        "verification_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/publicKey"
          }
        }
      }
    },
    "avatar_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public_key",
          "algorithm",
          "purpose"
        ],
        "properties": {
          "public_key": {
            "$ref": "#/$defs/publicKey"
          },
          "algorithm": {
            "enum": [
              "Ed25519",
              "ES256",
              "RS256"
            ]
          },
          "purpose": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "avatar-authentication",
                "signing",
                "encryption"
              ]
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "revoked",
        "transferred"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "passkey",
              "multi_key",
              "recovery_credential",
              "external_identity"
            ]
          }
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "format": "uri"
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "publicKey": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kty",
            "crv",
            "x",
            "kid"
          ],
          "properties": {
            "kty": {
              "const": "OKP"
            },
            "crv": {
              "const": "Ed25519"
            },
            "x": {
              "type": "string",
              "minLength": 40
            },
            "kid": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "active",
                "rotated",
                "revoked"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "revoked_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kty",
            "crv",
            "x",
            "y",
            "kid"
          ],
          "properties": {
            "kty": {
              "const": "EC"
            },
            "crv": {
              "const": "P-256"
            },
            "x": {
              "type": "string",
              "minLength": 40
            },
            "y": {
              "type": "string",
              "minLength": 40
            },
            "kid": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "active",
                "rotated",
                "revoked"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "revoked_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kty",
            "n",
            "e",
            "kid"
          ],
          "properties": {
            "kty": {
              "const": "RSA"
            },
            "n": {
              "type": "string",
              "minLength": 128
            },
            "e": {
              "type": "string",
              "minLength": 2
            },
            "kid": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "active",
                "rotated",
                "revoked"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "revoked_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    }
  },
  "$comment": "SPDX-License-Identifier: Apache-2.0; Copyright 2026 Wang Lu"
}
