{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aiap.dev/v0.3/schemas/key-set.schema.json",
  "title": "AIAP Public Key Set v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "keys",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/publicKey"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "publicKey": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kty",
            "crv",
            "x",
            "kid"
          ],
          "properties": {
            "kty": {
              "const": "OKP"
            },
            "crv": {
              "const": "Ed25519"
            },
            "x": {
              "type": "string",
              "minLength": 40
            },
            "kid": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "active",
                "rotated",
                "revoked"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "revoked_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kty",
            "crv",
            "x",
            "y",
            "kid"
          ],
          "properties": {
            "kty": {
              "const": "EC"
            },
            "crv": {
              "const": "P-256"
            },
            "x": {
              "type": "string",
              "minLength": 40
            },
            "y": {
              "type": "string",
              "minLength": 40
            },
            "kid": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "active",
                "rotated",
                "revoked"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "revoked_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kty",
            "n",
            "e",
            "kid"
          ],
          "properties": {
            "kty": {
              "const": "RSA"
            },
            "n": {
              "type": "string",
              "minLength": 128
            },
            "e": {
              "type": "string",
              "minLength": 2
            },
            "kid": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "active",
                "rotated",
                "revoked"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "revoked_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    }
  },
  "$comment": "SPDX-License-Identifier: Apache-2.0; Copyright 2026 Wang Lu"
}
