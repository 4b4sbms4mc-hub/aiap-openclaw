{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.aiap.dev/v0.3/schemas/memory.schema.json",
  "title": "AIAP Memory Entry v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_id",
    "type",
    "content",
    "created_at"
  ],
  "properties": {
    "memory_id": {
      "type": "string",
      "pattern": "^aiap:memory:[A-Za-z0-9._~-]{8,128}$"
    },
    "type": {
      "enum": [
        "semantic",
        "episodic",
        "procedural",
        "project"
      ]
    },
    "content": {},
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "portable": {
      "type": "boolean",
      "default": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$comment": "SPDX-License-Identifier: Apache-2.0; Copyright 2026 Wang Lu"
}
