{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiap.invalid/core-profile/0.1-draft/object-reference.schema.json",
  "title": "AIAP Core Profile draft — object-reference",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "space_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "owner_ref",
        "space_ref",
        "policy_ref"
      ],
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "id",
    "version",
    "scope",
    "sha256"
  ],
  "additionalProperties": false
}
