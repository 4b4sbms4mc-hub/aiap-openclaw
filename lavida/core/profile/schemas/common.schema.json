{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiap.invalid/core-profile/0.1-draft/common.schema.json",
  "title": "AIAP Core Profile draft — common",
  "$defs": {
    "scope": {
      "type": "object",
      "properties": {
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "space_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "owner_ref",
        "space_ref",
        "policy_ref"
      ],
      "additionalProperties": false
    },
    "version_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "crypto_profile": {
          "type": "string",
          "minLength": 1
        },
        "key_ref": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "crypto_profile",
        "key_ref",
        "signature"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "critical": {
            "type": "boolean"
          }
        },
        "required": [
          "namespace",
          "version",
          "critical"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
