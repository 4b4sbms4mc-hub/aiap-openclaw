{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiap.invalid/core-profile/0.1-draft/memory-record.schema.json",
  "title": "AIAP Core Profile draft — memory-record",
  "allOf": [
    {
      "$ref": "https://aiap.dev/schema/v0.1/memory.schema.json#/properties/data/properties/items/items"
    },
    {
      "type": "object",
      "required": [
        "scope",
        "revision",
        "previous_revision",
        "derived_from",
        "lifecycle",
        "updated_at",
        "confidence",
        "status",
        "source"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "properties": {
            "owner_ref": {
              "type": "string",
              "minLength": 1
            },
            "space_ref": {
              "type": "string",
              "minLength": 1
            },
            "policy_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "owner_ref",
            "space_ref",
            "policy_ref"
          ],
          "additionalProperties": false
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "previous_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "object-reference.schema.json"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "policy_ref": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            "last_used_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "context_use_count": {
              "type": "integer",
              "minimum": 0
            },
            "confirmed_use_count": {
              "type": "integer",
              "minimum": 0
            },
            "stable_preference": {
              "type": "boolean"
            },
            "recurrence_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "expected_next_use": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "last_verified": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "active_task_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "policy_ref",
            "last_used_at",
            "context_use_count",
            "confirmed_use_count",
            "stable_preference",
            "recurrence_ref",
            "expected_next_use",
            "last_verified",
            "active_task_refs"
          ],
          "additionalProperties": false
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "candidate",
            "active",
            "superseded",
            "revoked"
          ]
        },
        "source": {
          "required": [
            "source_type",
            "source_ref"
          ]
        }
      }
    }
  ],
  "description": "Additive refinement of v0.1 memory items. M3 + active expresses usable archive; deletion uses tombstone."
}
