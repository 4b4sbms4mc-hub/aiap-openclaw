{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aiap.invalid/core-profile/0.1-draft/lifecycle-policy.schema.json",
  "title": "AIAP Core Profile draft — lifecycle-policy",
  "type": "object",
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "archive_after_days": {
      "type": "object",
      "properties": {
        "M1": {
          "type": "integer",
          "minimum": 1
        },
        "M2": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "M1",
        "M2"
      ],
      "additionalProperties": false
    },
    "expected_use_protection_days": {
      "type": "integer",
      "minimum": 0
    },
    "automatic_archive": {
      "type": "boolean"
    },
    "never_auto_delete": {
      "const": true
    },
    "protect_pinned": {
      "const": true
    },
    "protect_stable_preferences": {
      "const": true
    },
    "protect_recurring": {
      "const": true
    },
    "protect_active_tasks": {
      "const": true
    },
    "use_basis": {
      "const": "authorized-context-use"
    }
  },
  "required": [
    "policy_id",
    "revision",
    "previous_revision",
    "archive_after_days",
    "expected_use_protection_days",
    "automatic_archive",
    "never_auto_delete",
    "protect_pinned",
    "protect_stable_preferences",
    "protect_recurring",
    "protect_active_tasks",
    "use_basis"
  ],
  "additionalProperties": false
}
