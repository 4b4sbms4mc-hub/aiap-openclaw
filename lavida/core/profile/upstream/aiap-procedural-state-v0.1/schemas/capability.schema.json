{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiap.dev/schema/v0.1/capability.schema.json",
  "title": "AIAP Capability v0.1",
  "description": "First-class, runtime-neutral semantic capability contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "name",
    "semantic_namespace",
    "description",
    "version",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^aiap:capability:[A-Za-z0-9._:-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "semantic_namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "inputs_schema": {
      "type": "object"
    },
    "outputs_schema": {
      "type": "object"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "quality_requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "security_requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "equivalence_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted_mapping_classes": {
          "type": "array",
          "items": {
            "enum": [
              "exact",
              "compatible",
              "partial",
              "composite",
              "unresolved"
            ]
          },
          "uniqueItems": true
        },
        "minimum_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}