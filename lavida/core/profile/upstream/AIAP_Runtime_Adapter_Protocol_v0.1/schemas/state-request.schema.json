{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiap.dev/schema/v0.1/state-request.schema.json",
  "title": "AIAP StateRequest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "runtime_id",
    "purpose",
    "requested_domains",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^aiap:state-request:[A-Za-z0-9._:-]+$"
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "requested_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "reason"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "maximum_disclosure": {
      "enum": [
        "minimal",
        "task_scoped",
        "workflow_scoped"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": true
    }
  }
}