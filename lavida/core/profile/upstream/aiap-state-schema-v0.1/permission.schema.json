{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiap.dev/schema/v0.1/permission.schema.json",
  "title": "AIAP Permission Domain v0.1",
  "type": "object",
  "required": [
    "domain_id",
    "version",
    "data"
  ],
  "properties": {
    "domain_id": {
      "const": "aiap.permissions"
    },
    "version": {
      "const": "0.1"
    },
    "data": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "permission_id",
              "subject",
              "resource",
              "actions",
              "scope",
              "approval"
            ],
            "properties": {
              "permission_id": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "resource": {
                "type": "string"
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "scope": {
                "type": "string",
                "enum": [
                  "deny",
                  "ask",
                  "session",
                  "workflow",
                  "project",
                  "persistent"
                ]
              },
              "approval": {
                "type": "string",
                "enum": [
                  "user",
                  "policy",
                  "administrator"
                ]
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "status": {
                "$ref": "common.schema.json#/$defs/lifecycleStatus"
              },
              "extensions": {
                "$ref": "common.schema.json#/$defs/extensionBag"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensionBag"
    }
  },
  "additionalProperties": true
}
