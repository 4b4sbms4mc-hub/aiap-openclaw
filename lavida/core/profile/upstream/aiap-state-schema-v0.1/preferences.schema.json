{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiap.dev/schema/v0.1/preferences.schema.json",
  "title": "AIAP Preferences Domain v0.1",
  "type": "object",
  "required": [
    "domain_id",
    "version",
    "data"
  ],
  "properties": {
    "domain_id": {
      "const": "aiap.preferences"
    },
    "version": {
      "const": "0.1"
    },
    "data": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "preference_id",
              "namespace",
              "key",
              "value",
              "source",
              "status"
            ],
            "properties": {
              "preference_id": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "value": {},
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "source": {
                "$ref": "common.schema.json#/$defs/provenance"
              },
              "status": {
                "$ref": "common.schema.json#/$defs/lifecycleStatus"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "extensions": {
                "$ref": "common.schema.json#/$defs/extensionBag"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensionBag"
    }
  },
  "additionalProperties": true
}
